{
  "name": "@zoeyetc/computational-listening-engine",
  "version": "0.1.0",
  "description": "A framework for computational listening",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zoeyetc/computational-listening-engine.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "node scripts/build.mjs",
    "prepack": "npm run check:boundaries && npm run typecheck && npm run build",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
